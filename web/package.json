    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/test-utils": "^4.1.0",
    "@playwright/test": "^1.61.1",
    "typescript": "^5.9.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.0.0",
    "prettier": "^3.9.6"
  }
}
